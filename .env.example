# Public image published from this repository, or your own compatible build.
AIRTRAIL_ICS_IMAGE=ghcr.io/your-github-user/airtrail-ics:latest

# Direct local feed: http://127.0.0.1:18080/calendar.ics
AIRTRAIL_ICS_BIND=127.0.0.1
AIRTRAIL_ICS_PORT=18080

# AirTrail instance origin, without /api/flight/list.
AIRTRAIL_URL=https://airtrail.example.com

# Create this in AirTrail under Settings -> Security.
AIRTRAIL_API_KEY=replace-with-your-airtrail-api-key

# mine (default), user, or all. user/all require suitable AirTrail permissions.
AIRTRAIL_SCOPE=mine
# Required only when AIRTRAIL_SCOPE=user.
AIRTRAIL_USER_ID=

CALENDAR_NAME=AirTrail Flights

# Standard five-field cron expression. Example nightly at 03:00: 0 3 * * *
SYNC_CRON=0 */6 * * *
SYNC_TIMEZONE=Europe/Copenhagen

# Retries after the initial attempt. Delays are 1m, 2m, 4m, then capped at 15m.
SYNC_RETRY_COUNT=3
HTTP_TIMEOUT=30s

# Optional: required only when the Caddy profile is enabled.
CALENDAR_DOMAIN=calendar.example.com

# Generate with: openssl rand -hex 32
CALENDAR_TOKEN=replace-with-a-64-character-random-hex-token
